<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Pricing — OutRay</title>
    <style>
        .pricing-grid {
            display: grid;
            grid-template-columns: 1fr;
            max-width: 600px;
            margin: 64px auto 0;
        }
        .price-card {
            background: var(--surface);
            border: 2px solid var(--accent);
            border-radius: 24px;
            padding: 64px 48px;
            text-align: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 30px 100px rgba(79, 142, 247, 0.1);
        }
        .price-card::before {
            content: 'MOST POPULAR';
            position: absolute;
            top: 20px;
            right: -30px;
            background: var(--accent);
            color: #fff;
            font-size: 10px;
            font-weight: 800;
            padding: 8px 40px;
            transform: rotate(45deg);
        }
        .price-val {
            font-size: 72px;
            font-weight: 900;
            letter-spacing: -4px;
            margin: 20px 0;
            background: linear-gradient(135deg, #fff, var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .price-features {
            text-align: left;
            margin: 40px 0;
            display: grid;
            gap: 16px;
        }
        .p-feat {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 15px;
            color: var(--text);
        }
        .p-feat svg { color: var(--accent3); }
    </style>
</head>
<body>
    <canvas id="net-canvas"></canvas>
    <%- include('partials/nav') %>

    <section style="padding-top: 180px;">
        <div class="container text-center">
            <div class="anim-fade">
                <div class="section-eyebrow">Pricing</div>
                <h1 class="section-title">One plan.<br>Everything free.</h1>
                <p class="section-sub" style="margin: 0 auto;">No tiers. No limits. No credit card. Just pure tunneling power provided to the community.</p>
            </div>

            <div class="pricing-grid anim-scale">
                <div class="price-card">
                    <h3 style="font-size: 14px; text-transform: uppercase; letter-spacing: 2px; color: var(--muted);">Pro Plan</h3>
                    <div class="price-val">$0<span style="font-size: 18px; font-weight: 500; letter-spacing: 0; color: var(--muted); -webkit-text-fill-color: var(--muted);">/forever</span></div>
                    
                    <div class="price-features">
                        <div class="p-feat">
                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            Unlimited HTTP/HTTPS Tunnels
                        </div>
                        <div class="p-feat">
                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            Custom Subdomains
                        </div>
                        <div class="p-feat">
                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            TCP Tunnelling (SSH, RDP, etc)
                        </div>
                        <div class="p-feat">
                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            Team Organizations
                        </div>
                        <div class="p-feat">
                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            Dedicated Live Support
                        </div>
                    </div>

                    <a href="/register" class="btn-primary" style="width: 100%; justify-content: center; padding: 18px;">Start Tunneling Now</a>
                    
                    <p style="margin-top: 32px; font-size: 12px; color: var(--muted);">
                        Sponsored by <a href="https://preciousadedokun.com.ng" target="_blank" style="color: var(--accent); font-weight: 700; text-decoration: none;">Apcodesphere ↗</a>
                    </p>
                </div>
            </div>

            <div class="anim-fade" style="margin-top: 80px; max-width: 600px; margin-left: auto; margin-right: auto;">
                <h2 style="font-size: 24px; font-weight: 800; margin-bottom: 16px;">Wait, why is it free?</h2>
                <p style="color: var(--muted); font-size: 15px;">
                    OutRay was built to empower developers. We believe world-class tooling shouldn't be locked behind a paywall. 
                    Development costs are covered by <strong>Apcodesphere</strong> (Precious Adedokun) as a contribution to the global developer ecosystem.
                </p>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <div class="footer-inner">
                <div class="footer-brand">
                    © 2026 OutRay · Provided by <a href="https://preciousadedokun.com.ng" target="_blank">Apcodesphere</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        gsap.registerPlugin(ScrollTrigger);
        gsap.to('.anim-fade', {opacity:1, y:0, duration:0.8, stagger:0.2, ease:'power2.out'});
        gsap.to('.anim-scale', {opacity:1, scale:1, duration:1, delay:0.4, ease:'elastic.out(1, 0.75)'});
        
        // Background network
        <%- include('partials/network_js') %>
    </script>
</body>
</html>
