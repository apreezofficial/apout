<%- include('partials/sidebar', {pageTitle:'Active Tunnels', activeNav:'tunnels', activeOrg, orgs, user, tunnelCount}) %>

<div class="p-8 max-w-5xl w-full">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-white tracking-tight flex items-center gap-3">
                Active Tunnels
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#3fb950]/10 text-[#3fb950] border border-[#3fb950]/20">
                   <span class="w-1.5 h-1.5 rounded-full bg-[#3fb950] animate-pulse"></span>
                   Real-time
                </span>
            </h1>
            <p class="text-[#8b949e] text-sm mt-1">Live traffic relays currently connected to your infrastructure.</p>
        </div>
        <div class="flex items-center gap-4">
            <div class="text-right hidden sm:block">
                <div class="text-[10px] font-bold text-[#484f58] uppercase">Global Relay Status</div>
                <div class="text-[11px] text-[#3fb950] font-bold">100% Operational</div>
            </div>
            <div class="w-10 h-10 rounded-full border border-[#30363d] flex items-center justify-center text-[#3fb950]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
        </div>
    </div>

    <!-- Tunnels Grid -->
    <% if (tunnels.length === 0) { %>
        <div class="card p-16 text-center bg-gradient-to-b from-[#161b22]/50 to-transparent">
            <div class="w-20 h-20 bg-[#21262d] rounded-2xl flex items-center justify-center mx-auto mb-6 transform -rotate-6 border border-[#30363d]">
                <svg class="w-10 h-10 text-[#484f58]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h4 class="text-white font-bold text-xl mb-2">No tunnels active right now</h4>
            <p class="text-[#8b949e] text-sm mt-1 max-w-sm mx-auto mb-8 leading-relaxed">Your tunnels will appear here instantly as soon as you launch the CLI and connect to our relay.</p>
            
            <div class="max-w-md mx-auto bg-black/40 rounded-xl p-4 border border-[#30363d] text-left">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-[10px] font-bold text-[#484f58] uppercase">Quick Start Command</span>
                    <button onclick="navigator.clipboard.writeText('OutRay start --port 3000')" class="text-[#58a6ff] hover:text-white text-[10px] font-bold uppercase transition-colors">Copy</button>
                </div>
                <code class="text-[13px] font-mono text-[#79c0ff]">
                    <span class="text-[#8b949e]">$</span> OutRay start --port 3000
                </code>
            </div>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% tunnels.forEach(t => { %>
                <div class="card p-6 hover:border-[#1f6feb] transition-all group relative overflow-hidden bg-gradient-to-br from-[#161b22] to-[#0d1117]">
                    <!-- Background Glow -->
                    <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-[#1f6feb]/5 rounded-full blur-[40px] group-hover:bg-[#1f6feb]/10 transition-all"></div>
                    
                    <div class="flex items-start justify-between mb-6 relative z-10">
                        <div class="w-10 h-10 rounded-xl bg-[#1f6feb]/10 border border-[#1f6feb]/20 flex items-center justify-center text-[#1f6feb]">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        </div>
                        <div class="flex items-center gap-2">
                             <span class="w-2 h-2 rounded-full bg-[#3fb950] shadow-[0_0_10px_#3fb950]"></span>
                             <span class="text-[10px] font-bold text-[#3fb950] uppercase tracking-widest">Connected</span>
                        </div>
                    </div>

                    <div class="relative z-10 mb-6">
                        <div class="text-[10px] font-bold text-[#484f58] uppercase mb-1">Public Address</div>
                        <a href="https://<%= t.subdomain %>.OutRay.dev" target="_blank" class="text-lg font-mono font-bold text-[#58a6ff] hover:text-[#79c0ff] transition-colors truncate block">
                            <%= t.subdomain %>.OutRay.dev
                        </a>
                    </div>

                    <div class="grid grid-cols-2 gap-4 relative z-10">
                        <div class="bg-black/30 p-3 rounded-lg border border-[#30363d]">
                            <div class="text-[9px] font-bold text-[#484f58] uppercase mb-1">Local Port</div>
                            <div class="text-sm font-mono text-white">:<%= t.local_port %></div>
                        </div>
                        <div class="bg-black/30 p-3 rounded-lg border border-[#30363d]">
                            <div class="text-[9px] font-bold text-[#484f58] uppercase mb-1">Uptime</div>
                            <div class="text-sm font-mono text-white">4m 12s</div> <!-- Simplified placeholder -->
                        </div>
                    </div>

                    <div class="mt-6 pt-5 border-t border-[#30363d] flex items-center justify-between relative z-10">
                        <div class="text-[10px] text-[#8b949e]">
                            Started <%= new Date(t.created_at).toLocaleTimeString() %>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="navigator.clipboard.writeText('https://<%= t.subdomain %>.OutRay.dev')" class="p-2 text-[#8b949e] hover:text-white transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            </button>
                            <a href="/dashboard/<%= activeOrg.slug %>/requests" class="p-2 text-[#8b949e] hover:text-white transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

    <!-- Command Tip -->
    <div class="mt-8 p-6 bg-[#1f6feb]/5 border border-[#1f6feb]/20 rounded-2xl flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-[#1f6feb]/10 flex items-center justify-center text-[#1f6feb]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <p class="text-[13px] text-[#8b949e]">
                Every tunnel session is isolated and encrypted. You can share your public URL with confidence.
            </p>
        </div>
        <a href="/docs" class="text-[11px] font-bold text-[#58a6ff] hover:underline uppercase tracking-widest whitespace-nowrap">View Docs</a>
    </div>
</div>

<%- include('partials/end') %>
